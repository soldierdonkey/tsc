{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Typed Symbolic Code",
  "scopeName": "source.tsc",
  "patterns": [
    {
      "include": "#value"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "^\\s*(;;;;+)(?![;:])\\s*(\\d+(?:\\.\\d+)*)?\\s*(.*?)\\s*(\\((?:old )?todo\\))?\\s*$",
          "name": "comment.line.header.level-4.tsc",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.tsc"
            },
            "2": {
              "name": "markup.heading.number.tsc constant.numeric.section.tsc"
            },
            "3": {
              "name": "markup.heading.tsc"
            },
            "4": {
              "name": "keyword.other.todo.tsc"
            }
          }
        },
        {
          "match": "^\\s*(;;;)(?![;:])\\s*(\\d+(?:\\.\\d+)*)?\\s*(.*?)\\s*(\\((?:old )?todo\\))?\\s*$",
          "name": "comment.line.header.level-3.tsc",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.tsc"
            },
            "2": {
              "name": "markup.heading.number.tsc constant.numeric.section.tsc"
            },
            "3": {
              "name": "markup.heading.tsc"
            },
            "4": {
              "name": "keyword.other.todo.tsc"
            }
          }
        },
        {
          "match": "^\\s*(;;)(?![;:])\\s*(\\d+(?:\\.\\d+)*)?\\s*(.*?)\\s*(\\((?:old )?todo\\))?\\s*$",
          "name": "comment.line.header.level-2.tsc",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.tsc"
            },
            "2": {
              "name": "markup.heading.number.tsc constant.numeric.section.tsc"
            },
            "3": {
              "name": "markup.heading.tsc"
            },
            "4": {
              "name": "keyword.other.todo.tsc"
            }
          }
        },
        {
          "begin": "(;)(:)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.tsc"
            },
            "2": {
              "name": "punctuation.definition.comment.doc.tsc"
            }
          },
          "name": "comment.line.documentation.tsc",
          "patterns": [
            {
              "include": "#comment-annotations"
            }
          ]
        },
        {
          "begin": ";+",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.tsc"
            }
          },
          "name": "comment.line.semicolon.tsc",
          "patterns": [
            {
              "match": "\\G\\s*(\\d+\\.|[a-z]\\.)(?=\\s)",
              "captures": {
                "1": {
                  "name": "markup.list.numbered.tsc constant.numeric.rule.tsc"
                }
              }
            },
            {
              "include": "#comment-annotations"
            }
          ]
        }
      ]
    },
    "comment-annotations": {
      "patterns": [
        {
          "match": "\\G\\s*(why\\?:)",
          "captures": {
            "1": {
              "name": "keyword.other.reason.unconfirmed.tsc"
            }
          }
        },
        {
          "match": "\\G\\s*(why:)",
          "captures": {
            "1": {
              "name": "keyword.other.reason.tsc"
            }
          }
        },
        {
          "match": "\\G\\s*(hypothetical:)",
          "captures": {
            "1": {
              "name": "keyword.other.hypothetical.tsc"
            }
          }
        },
        {
          "match": "\\berror:",
          "name": "invalid.illegal.outcome.error.tsc"
        },
        {
          "match": "\\bpanics:",
          "name": "invalid.illegal.outcome.panic.tsc"
        },
        {
          "match": "\\bwarning:",
          "name": "invalid.deprecated.outcome.warning.tsc"
        },
        {
          "match": "\\b(?:prints|type):",
          "name": "keyword.other.outcome.tsc"
        },
        {
          "match": "\\G\\s*(returns)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.outcome.tsc"
            }
          }
        },
        {
          "match": "(?<=;\\s)returns\\b",
          "name": "keyword.other.outcome.tsc"
        },
        {
          "match": "\\[\\d+(?:\\.\\d+)+(?:,\\s*\\d+(?:\\.\\d+)+)*\\]",
          "name": "constant.other.rule-tag.tsc"
        },
        {
          "match": "\\(\\d+(?:\\.\\d+)*(?:,\\s*\\d+(?:\\.\\d+)*)*\\)",
          "name": "markup.underline.link.reference.tsc"
        },
        {
          "match": "\\((?:old )?todo\\)",
          "name": "keyword.other.todo.tsc"
        }
      ]
    },
    "literal": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#fancy-string"
        },
        {
          "include": "#char"
        },
        {
          "match": "\\(\\s*\\)",
          "name": "constant.language.unit.tsc"
        },
        {
          "match": "(?:(?<![A-Za-z0-9_.])|(?=-))-?(?:\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*(?:e[+-]?\\d(?:_?\\d)*)?|e[+-]?\\d(?:_?\\d)*)(?:_f(?:32|64))?|(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0o[0-7](?:_?[0-7])*|0b[01](?:_?[01])*|\\d(?:_?\\d)*)(?:_[ui](?:8|16|32|64)|_f(?:32|64))?)(?![A-Za-z0-9_.])",
          "name": "constant.numeric.tsc"
        },
        {
          "match": "(?:(?<![A-Za-z0-9_.])|(?=-))-?\\d[A-Za-z0-9_.]*",
          "name": "invalid.illegal.numeric.tsc"
        },
        {
          "match": "(?<![A-Za-z0-9_.:])(?:false|true)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
          "name": "constant.language.boolean.tsc"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "match": "\\\\(?:[nrt0\\\\`$\"']|x[0-7][0-9A-Fa-f]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.tsc"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.tsc"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tsc"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tsc"
        }
      },
      "name": "string.quoted.double.tsc",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "fancy-string": {
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tsc"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tsc"
        }
      },
      "name": "string.template.tsc",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "match": "(\\$\\{)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\})",
          "name": "meta.template.expression.tsc",
          "captures": {
            "1": {
              "name": "punctuation.definition.template-expression.begin.tsc"
            },
            "2": {
              "name": "variable.parameter.tsc"
            },
            "3": {
              "name": "punctuation.definition.template-expression.end.tsc"
            }
          }
        }
      ]
    },
    "char": {
      "patterns": [
        {
          "match": "(')(?:[^'\\\\]|(\\\\(?:[nrt0\\\\`$\"']|x[0-7][0-9A-Fa-f]|u\\{[0-9A-Fa-f]{1,6}\\})))(')",
          "name": "string.quoted.single.char.tsc",
          "captures": {
            "1": {
              "name": "punctuation.definition.string.begin.tsc"
            },
            "2": {
              "name": "constant.character.escape.tsc"
            },
            "3": {
              "name": "punctuation.definition.string.end.tsc"
            }
          }
        },
        {
          "match": "'[^'\\n]*'",
          "name": "invalid.illegal.char.tsc"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#define"
        },
        {
          "include": "#type-decl"
        },
        {
          "include": "#mod"
        },
        {
          "include": "#fn"
        },
        {
          "include": "#paren"
        },
        {
          "include": "#brace"
        },
        {
          "include": "#forall"
        },
        {
          "include": "#type-bracket"
        },
        {
          "include": "#category"
        },
        {
          "include": "#signature"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#binding-name"
        },
        {
          "include": "#name"
        },
        {
          "match": "[)\\]}]",
          "name": "invalid.illegal.stray-bracket.tsc"
        }
      ]
    },
    "define": {
      "patterns": [
        {
          "begin": "(\\()\\s*(define|let)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:=\\s*[{`]|:\\s*\\[(?:[^\\[\\]-]|-(?!>)|(\\[(?:[^\\[\\]]|\\g<4>)*\\]))*->))",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.parens.begin.tsc"
            },
            "2": {
              "name": "keyword.control.tsc"
            },
            "3": {
              "name": "entity.name.function.tsc"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.tsc"
            }
          },
          "name": "meta.definition.function.tsc",
          "patterns": [
            {
              "include": "#value"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(define|let)\\s+(?:([A-Z][A-Z0-9_]*)|([A-Za-z_][A-Za-z0-9_]*))(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.parens.begin.tsc"
            },
            "2": {
              "name": "keyword.control.tsc"
            },
            "3": {
              "name": "variable.other.constant.tsc"
            },
            "4": {
              "name": "variable.other.definition.tsc"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.tsc"
            }
          },
          "name": "meta.definition.variable.tsc",
          "patterns": [
            {
              "include": "#value"
            }
          ]
        }
      ]
    },
    "type-decl": {
      "patterns": [
        {
          "begin": "(\\()\\s*(struct)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])\\s*(?:(\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)((?:\\s+[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\])|([A-Za-z_][A-Za-z0-9_]*))?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.parens.begin.tsc"
            },
            "2": {
              "name": "keyword.control.tsc"
            },
            "3": {
              "name": "punctuation.definition.type.begin.tsc"
            },
            "4": {
              "name": "entity.name.type.struct.tsc"
            },
            "5": {
              "patterns": [
                {
                  "match": "[A-Za-z_][A-Za-z0-9_]*",
                  "name": "entity.name.type.parameter.tsc"
                }
              ]
            },
            "6": {
              "name": "punctuation.definition.type.end.tsc"
            },
            "7": {
              "name": "entity.name.type.struct.tsc"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.tsc"
            }
          },
          "name": "meta.definition.struct.tsc",
          "patterns": [
            {
              "include": "#value"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(enum)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])\\s*(?:(\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)((?:\\s+[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\])|([A-Za-z_][A-Za-z0-9_]*))?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.parens.begin.tsc"
            },
            "2": {
              "name": "keyword.control.tsc"
            },
            "3": {
              "name": "punctuation.definition.type.begin.tsc"
            },
            "4": {
              "name": "entity.name.type.enum.tsc"
            },
            "5": {
              "patterns": [
                {
                  "match": "[A-Za-z_][A-Za-z0-9_]*",
                  "name": "entity.name.type.parameter.tsc"
                }
              ]
            },
            "6": {
              "name": "punctuation.definition.type.end.tsc"
            },
            "7": {
              "name": "entity.name.type.enum.tsc"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.tsc"
            }
          },
          "name": "meta.definition.enum.tsc",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#signature"
            },
            {
              "include": "#category"
            },
            {
              "match": "(?<![A-Za-z0-9_.:])[A-Z][A-Za-z0-9_]*(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
              "name": "variable.other.enummember.tsc"
            },
            {
              "include": "#value"
            }
          ]
        }
      ]
    },
    "mod": {
      "begin": "(\\()\\s*(mod)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.parens.begin.tsc"
        },
        "2": {
          "name": "keyword.control.tsc"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.tsc"
        }
      },
      "name": "meta.import.tsc",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#category"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.tsc"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.tsc"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.namespace.tsc"
        }
      ]
    },
    "fn": {
      "begin": "(\\{)\\s*(fn)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])(?:\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[\\[|<]))?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.tsc storage.type.function.brace.begin.tsc"
        },
        "2": {
          "name": "keyword.control.tsc storage.type.function.tsc"
        },
        "3": {
          "name": "entity.name.function.tsc"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tsc storage.type.function.brace.end.tsc"
        }
      },
      "name": "meta.function.tsc",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "paren": {
      "begin": "(\\()\\s*((?:[a-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|\\d+))*|(?:==|<=|>=|\\+|-|\\*|\\/|%|<|>)(?=[\\s()\\[\\]{}|;]|$))?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.parens.begin.tsc"
        },
        "2": {
          "patterns": [
            {
              "include": "#head"
            }
          ]
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.tsc"
        }
      },
      "name": "meta.expression.value.tsc",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "brace": {
      "begin": "(\\{)\\s*((?:[a-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|\\d+))*|(?:==|<=|>=|\\+|-|\\*|\\/|%|<|>)(?=[\\s()\\[\\]{}|;]|$))?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.tsc storage.type.function.brace.begin.tsc"
        },
        "2": {
          "patterns": [
            {
              "include": "#head"
            }
          ]
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tsc storage.type.function.brace.end.tsc"
        }
      },
      "name": "meta.expression.function.tsc",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "head": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_.:])(?:forall|define|unless|struct|export|match|recur|when|enum|next|loop|let|for|mod|do|fn|if)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
          "name": "keyword.control.tsc"
        },
        {
          "match": "(?<![A-Za-z0-9_.:])(?:assert|print|panic|debug)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
          "name": "keyword.other.special-form.tsc"
        },
        {
          "match": "(?<![A-Za-z0-9_.:])(?:to_string|bit_not|bit_and|bit_xor|bit_or|try_as|clamp|parse|wrap|list|pow|abs|min|max|not|and|xor|shl|shr|get|or|as)(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
          "name": "support.function.builtin.tsc"
        },
        {
          "match": "(?:==|<=|>=|\\+|-|\\*|\\/|%|<|>)(?=[\\s()\\[\\]{}|;]|$)",
          "name": "support.function.builtin.operator.tsc"
        },
        {
          "match": "(?<![A-Za-z0-9_.:])(?:Option|Result|Never|Unit|List|Map)(?=\\.[A-Z])",
          "name": "support.type.builtin.tsc"
        },
        {
          "match": "[a-z_][A-Za-z0-9_]*(?=::)",
          "name": "entity.name.namespace.tsc"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.tsc"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.tsc"
        },
        {
          "match": "(?<=[A-Za-z0-9_]\\.)[A-Z][A-Za-z0-9_]*",
          "name": "variable.other.enummember.tsc"
        },
        {
          "match": "(?<=[A-Za-z0-9_]\\.)[a-z_][A-Za-z0-9_]*",
          "name": "entity.name.function.accessor.tsc"
        },
        {
          "match": "[A-Z][A-Za-z0-9_]*",
          "name": "entity.name.type.tsc"
        },
        {
          "match": "[a-z_][A-Za-z0-9_]*",
          "name": "entity.name.function.tsc"
        }
      ]
    },
    "binding-name": {
      "match": "(?<![A-Za-z0-9_.:])([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=(?![=>]))",
      "captures": {
        "1": {
          "name": "variable.other.property.binding.tsc"
        }
      }
    },
    "annotation": {
      "match": "(:)(?!:)\\s*((?:[a-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*)?",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.tsc"
        },
        "2": {
          "name": "meta.type.tsc",
          "patterns": [
            {
              "include": "#type-name"
            }
          ]
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": "->",
          "name": "storage.type.function.arrow.tsc"
        },
        {
          "match": "=>",
          "name": "keyword.operator.arm.tsc"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.repetition.notation.tsc"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.spread.tsc"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.tsc"
        },
        {
          "match": "(\\^)((?:[a-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|\\d+))*)?",
          "captures": {
            "1": {
              "name": "keyword.operator.pin.tsc"
            },
            "2": {
              "name": "variable.other.pinned.tsc",
              "patterns": [
                {
                  "include": "#name"
                }
              ]
            }
          }
        },
        {
          "match": "@",
          "name": "keyword.operator.binding.tsc"
        },
        {
          "match": "==",
          "name": "support.function.builtin.operator.tsc"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.tsc"
        },
        {
          "match": "(?<![A-Za-z0-9_.:])_(?![A-Za-z0-9_:]|\\.[A-Za-z0-9_])",
          "name": "variable.language.wildcard.tsc"
        },
        {
