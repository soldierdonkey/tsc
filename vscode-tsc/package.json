{
  "name": "typed-symbolic-code",
  "displayName": "Typed Symbolic Code",
  "description": "Syntax highlighting, comment-header folding, and whitespace warnings with quick fixes for Typed Symbolic Code (.tsc) drafts.",
  "publisher": "local",
  "version": "0.2.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:tsc"],
  "contributes": {
    "languages": [
      {
        "id": "tsc",
        "aliases": ["Typed Symbolic Code", "tsc"],
        "extensions": [".tsc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tsc",
        "scopeName": "source.tsc",
        "path": "./syntaxes/tsc.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[tsc]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordSeparators": "`()[]{}|\"',;:",
        "editor.bracketPairColorization.enabled": true
      }
    },
    "commands": [
      {
        "command": "tsc.fixAllWhitespace",
        "title": "Fix All Whitespace",
        "category": "TSC"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "tsc.fixAllWhitespace", "when": "editorLangId == tsc" }
      ]
    },
    "configuration": {
      "title": "Typed Symbolic Code",
      "properties": {
        "tsc.whitespace.enable": {
          "type": "boolean",
          "default": true,
          "description": "Warn about whitespace that breaks the spec's layout rules (1.2, 1.5), with quick fixes."
        }
      }
    }
  }
}
